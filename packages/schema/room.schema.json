{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zipchak.app/schema/room.schema.json",
  "title": "RoomData",
  "description": "방의 기하 정보. 입력부(정밀 모드·자유 모드)가 만들고 모든 모듈이 읽는다. 길이 단위는 mm 정수.",
  "type": "object",
  "required": ["schemaVersion", "roomId", "ownerId", "name", "source", "unit", "ceilingHeight", "floorPolygon", "walls", "openings", "fixtures", "existingFurniture", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "$defs": {
    "mm": { "type": "integer" },
    "point2": {
      "type": "object",
      "required": ["x", "z"],
      "additionalProperties": false,
      "properties": { "x": { "$ref": "#/$defs/mm" }, "z": { "$ref": "#/$defs/mm" } }
    },
    "point3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": { "x": { "$ref": "#/$defs/mm" }, "y": { "$ref": "#/$defs/mm" }, "z": { "$ref": "#/$defs/mm" } }
    },
    "dimensions": {
      "type": "object",
      "required": ["width", "depth", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "depth": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "category": {
      "enum": ["bed", "desk", "chair", "storage", "shelf", "table", "wardrobe", "sofa", "lamp", "decor", "etc"]
    },
    "rotationDeg": { "enum": [0, 90, 180, 270] },
    "facing": { "enum": ["N", "NE", "E", "SE", "S", "SW", "W", "NW", null] }
  },
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "roomId": { "type": "string", "pattern": "^room_" },
    "ownerId": { "type": "string" },
    "name": { "type": "string", "maxLength": 40 },
    "source": {
      "description": "lidar = 정밀 모드, 나머지 = 자유 모드",
      "enum": ["lidar", "manual", "template", "floorplan"]
    },
    "sourceMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device": { "type": ["string", "null"] },
        "roomPlanVersion": { "type": ["string", "null"] },
        "rawAssetUrl": { "type": ["string", "null"] },
        "templateId": { "type": ["string", "null"] },
        "floorplanImageUrl": { "type": ["string", "null"] }
      }
    },
    "unit": { "const": "mm" },
    "ceilingHeight": { "type": "integer", "minimum": 2000, "maximum": 5000 },
    "floorPolygon": {
      "description": "바닥 윤곽 (닫힌 다각형, 마지막 점은 첫 점과 다르게). 바운딩 박스 최소 점이 (0,0).",
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/point2" }
    },
    "walls": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "height", "thickness"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "start": { "$ref": "#/$defs/point2" },
          "end": { "$ref": "#/$defs/point2" },
          "height": { "type": "integer", "minimum": 1 },
          "thickness": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "wallId", "offset", "width", "height", "sillHeight", "swing"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["door", "window", "opening"] },
          "wallId": { "type": "string" },
          "offset": { "description": "벽 start에서 개구부 시작 모서리까지 거리", "type": "integer", "minimum": 0 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "sillHeight": { "type": "integer", "minimum": 0 },
          "facing": { "$ref": "#/$defs/facing", "description": "창문이 바라보는 방위 (채광 계산·M4-5용). 모르면 null" },
          "swing": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["kind", "hingeSide", "opensInward", "maxAngleDeg"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "enum": ["hinged", "sliding"] },
                  "hingeSide": { "enum": ["left", "right"] },
                  "opensInward": { "type": "boolean" },
                  "maxAngleDeg": { "type": "integer", "minimum": 0, "maximum": 180 }
                }
              }
            ]
          }
        }
      }
    },
    "fixtures": {
      "description": "배치 불가 고정물",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["radiator", "pillar", "outlet", "aircon", "sink", "closet_builtin"] },
          "footprint": { "type": "array", "items": { "$ref": "#/$defs/point2" } },
          "height": { "type": "integer" },
          "position": { "$ref": "#/$defs/point3" },
          "direction": { "description": "에어컨 바람 방향 (단위 벡터 근사, 침대 위치 점수용)", "$ref": "#/$defs/point2" }
        }
      }
    },
    "existingFurniture": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["instanceId", "category", "dimensions", "position", "rotationDeg", "movable"],
        "additionalProperties": false,
        "properties": {
          "instanceId": { "type": "string" },
          "category": { "$ref": "#/$defs/category" },
          "catalogItemId": { "type": ["string", "null"] },
          "label": { "type": "string" },
          "dimensions": { "$ref": "#/$defs/dimensions" },
          "position": { "$ref": "#/$defs/point2" },
          "rotationDeg": { "$ref": "#/$defs/rotationDeg" },
          "movable": { "type": "boolean" },
          "detectedBy": { "enum": ["roomplan", "user"] },
          "confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
